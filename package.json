{
  "name": "vsc-interactive-review",
  "publisher": "eccentricqualitysolutions",
  "displayName": "Interactive Review",
  "description": "Walk a queue of pending AI edits — per-hunk accept/reject review flow (stable API, forked from molon/hunkwise).",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davemackey/vsc-interactive-review"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "interactiveReview.enable",
        "title": "Interactive Review: Enable"
      },
      {
        "command": "interactiveReview.disable",
        "title": "Interactive Review: Disable"
      },
      {
        "command": "interactiveReview.openSettings",
        "title": "Interactive Review: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "interactiveReview.refresh",
        "title": "Interactive Review: Refresh State",
        "icon": "$(refresh)"
      },
      {
        "command": "interactiveReview.acceptHunk",
        "title": "Interactive Review: Accept Hunk",
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.rejectHunk",
        "title": "Interactive Review: Reject Hunk",
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.rejectSelection",
        "title": "Interactive Review: Reject Selected Lines",
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.acceptSelection",
        "title": "Interactive Review: Accept Selected Lines",
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.acceptFile",
        "title": "Interactive Review: Approve File",
        "icon": {
          "light": "media/approve-file-light.svg",
          "dark": "media/approve-file-dark.svg"
        },
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.rejectFile",
        "title": "Interactive Review: Revert File",
        "icon": {
          "light": "media/revert-file-light.svg",
          "dark": "media/revert-file-dark.svg"
        },
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.nextHunk",
        "title": "Interactive Review: Next Hunk",
        "enablement": "interactiveReview.inReview"
      },
      {
        "command": "interactiveReview.prevHunk",
        "title": "Interactive Review: Previous Hunk",
        "enablement": "interactiveReview.inReview"
      }
    ],
    "keybindings": [
      {
        "command": "interactiveReview.acceptHunk",
        "key": "alt+a",
        "when": "interactiveReview.inReview && editorTextFocus"
      },
      {
        "command": "interactiveReview.rejectHunk",
        "key": "alt+r",
        "when": "interactiveReview.inReview && editorTextFocus"
      },
      {
        "command": "interactiveReview.rejectSelection",
        "key": "alt+shift+r",
        "when": "interactiveReview.inReview && editorTextFocus"
      },
      {
        "command": "interactiveReview.acceptSelection",
        "key": "alt+shift+a",
        "when": "interactiveReview.inReview && editorTextFocus"
      },
      {
        "command": "interactiveReview.nextHunk",
        "key": "alt+n",
        "when": "interactiveReview.inReview && editorTextFocus"
      },
      {
        "command": "interactiveReview.prevHunk",
        "key": "alt+p",
        "when": "interactiveReview.inReview && editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "interactiveReview.refresh",
          "when": "view == interactiveReviewToolbar",
          "group": "navigation"
        },
        {
          "command": "interactiveReview.openSettings",
          "when": "view == interactiveReviewToolbar",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "interactiveReview.acceptFile",
          "when": "interactiveReview.inReview",
          "group": "navigation@1"
        },
        {
          "command": "interactiveReview.rejectFile",
          "when": "interactiveReview.inReview",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "interactiveReviewPanel",
          "title": "Interactive Review",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "interactiveReviewPanel": [
        {
          "id": "interactiveReviewToolbar",
          "name": "Interactive Review",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "rm -rf out-test && tsc -p ./tsconfig.test.json && mkdir -p out-test/node_modules/vscode && cp out-test/test/__mocks__/vscode.js out-test/node_modules/vscode/index.js && node --test out-test/test/*.test.js",
    "test:integration": "npm run compile && tsc -p ./tsconfig.integration.json && vscode-test"
  },
  "devDependencies": {
    "@types/diff": "^5.x",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.37",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.x"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "ignore": "^7.0.5"
  }
}